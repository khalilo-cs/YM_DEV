# YEMENDEV AI configuration (environment variables). Copy to .env and adjust; never commit secrets.
# Values shown are the defaults. Secrets are NEVER put here: a model API key is referenced by the
# *name* of the variable that holds it (YEMENDEV_MODEL_API_KEY_ENV).

# Where the platform keeps its database, HMAC audit key and checkpoints (created 0700).
YEMENDEV_DATA_DIR=./.yemendev
# Optional: projects may only be registered under these roots (os.pathsep-separated). Empty = any.
YEMENDEV_ALLOWED_ROOTS=

# Sandbox: auto (docker when usable, else process with warnings) | docker (required) | process
YEMENDEV_SANDBOX_BACKEND=auto
YEMENDEV_SANDBOX_IMAGE=yemendev-sandbox:py3.13
# best_effort | required | disabled
YEMENDEV_NETWORK_ISOLATION=best_effort
YEMENDEV_SANDBOX_TIMEOUT=120
# Interpreter used by the *process* backend (defaults to the platform's own python).
# YEMENDEV_PYTHON=/usr/bin/python3

# Optional model (any OpenAI-compatible server: llama.cpp, Ollama, vLLM, hosted). Leave empty to run
# without a model - the platform works; model-based repair proposals are simply skipped.
YEMENDEV_MODEL_BASE_URL=
YEMENDEV_MODEL_NAME=
# Name of the environment variable that holds the API key (not the key itself), e.g. MY_MODEL_KEY
YEMENDEV_MODEL_API_KEY_ENV=

# API limits
YEMENDEV_RATE_LIMIT_PER_MINUTE=600
YEMENDEV_RATE_LIMIT_BURST=120
YEMENDEV_AUTH_FAILURES_PER_MINUTE=30
YEMENDEV_TOKEN_TTL_DAYS=90

# ORION background execution (see docs/DEPLOYMENT.md).
# Workers started by `yemendev serve` / `yemendev worker` (0 = none):
YEMENDEV_WORKERS=1
# Runs at the same time across all worker processes sharing this data directory:
YEMENDEV_MAX_CONCURRENT_RUNS=4
# Default wall-clock budget of one run, in seconds:
YEMENDEV_RUN_TIMEOUT=3600
# Default attempts for transient failures (sandbox/runtime/model endpoint unavailable, timeout):
YEMENDEV_MAX_ATTEMPTS=3

# CLI authentication: a token printed once by `yemendev init` or `yemendev token issue`. Do not commit.
# YEMENDEV_TOKEN=

# Built web UI directory (default: apps/web/dist of this checkout, if built)
# YEMENDEV_WEB_DIR=/opt/yemendev/web

# Observability (see docs/DEPLOYMENT.md). Log format json|text and level:
YEMENDEV_LOG_FORMAT=json
YEMENDEV_LOG_LEVEL=INFO
# Trace export: off|console|otlp (otlp needs the `otel` extra and OTEL_EXPORTER_OTLP_ENDPOINT):
YEMENDEV_OTEL=off
